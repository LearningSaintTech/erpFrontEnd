{"type":"frame-snapshot","snapshot":{"callId":"call@243","snapshotName":"after@call@243","pageId":"page@571be1351d54cfafda1315a878d4eb23","frameId":"frame@074c811c004d6bc1506224492d76d797","frameUrl":"http://localhost:5310/","doctype":"html","html":["HTML",{"lang":"en"},["HEAD",{},["BASE",{"href":"http://localhost:5310/"}],"\n    ","\n\n    ","\n\n    ",["META",{"charset":"utf-8"}],"\n    ",["META",{"name":"viewport","content":"width=device-width, initial-scale=1.0"}],"\n    ",["LINK",{"rel":"preconnect","href":"https://fonts.googleapis.com"}],"\n    ",["LINK",{"rel":"preconnect","href":"https://fonts.gstatic.com","crossorigin":""}],"\n    ",["LINK",{"href":"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap","rel":"stylesheet"}],"\n    ",["TITLE",{},"ERP Factory"],"\n  ",["STYLE",{},"/**\r\n * ERP Factory — design tokens + base component styles\r\n *\r\n * Calm neutral light workspace · white surfaces · hairline borders · one accent blue.\r\n * Tokens are defined on :root AND .erp-theme so portaled UI (modals, drawers, menus,\r\n * toasts) rendered into document.body gets them too. ThemeProvider also puts\r\n * `erp-theme` on <body>.\r\n *\r\n * Type scale: 12 caption/label · 13 table cell/secondary · 14 body/controls ·\r\n *             16 section title · 20 page title · 24–28 KPI value.\r\n *\r\n * Legacy --erp-* variables and erp-* classes are kept (restyled) — many pages use them.\r\n */\r\n\r\n:root,\r\n.erp-theme {\r\n  /* ── Typography ─────────────────────────────────────────── */\r\n  --erp-font-family: Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;\r\n  --erp-text-xs: 12px;   /* caption, label, badge */\r\n  --erp-text-sm: 13px;   /* table cells, secondary text */\r\n  --erp-text-base: 14px; /* body, controls */\r\n  --erp-text-md: 16px;   /* section title */\r\n  --erp-text-lg: 20px;   /* page title */\r\n  --erp-text-xl: 24px;   /* KPI value */\r\n  --erp-text-2xl: 28px;  /* hero KPI */\r\n  --erp-leading: 1.45;\r\n  --erp-leading-tight: 1.25;\r\n\r\n  /* legacy aliases */\r\n  --erp-font-xs: var(--erp-text-xs);\r\n  --erp-font-sm: var(--erp-text-sm);\r\n  --erp-font-base: var(--erp-text-base);\r\n  --erp-font-md: var(--erp-text-md);\r\n  --erp-font-lg: var(--erp-text-lg);\r\n\r\n  /* ── Spacing (4px grid) ─────────────────────────────────── */\r\n  --erp-space-1: 4px;\r\n  --erp-space-2: 8px;\r\n  --erp-space-3: 12px;\r\n  --erp-space-4: 16px;\r\n  --erp-space-5: 20px;\r\n  --erp-space-6: 24px;\r\n  --erp-space-8: 32px;\r\n  --erp-space-10: 40px;\r\n\r\n  /* ── Radii ──────────────────────────────────────────────── */\r\n  --erp-radius-sm: 6px;  /* controls, buttons, badges */\r\n  --erp-radius-md: 8px;  /* cards, menus, popovers */\r\n  --erp-radius-lg: 12px; /* modals, drawers, large panels */\r\n  --erp-radius-full: 9999px;\r\n\r\n  /* ── Controls ───────────────────────────────────────────── */\r\n  --erp-control-h: 36px;\r\n  --erp-control-h-sm: 32px;\r\n  --erp-row-h: 44px;\r\n  --erp-ease: cubic-bezier(0.4, 0, 0.2, 1);\r\n  --erp-duration: 140ms;\r\n\r\n  /* ── Neutrals ───────────────────────────────────────────── */\r\n  --erp-gray-50: #f9fafb;\r\n  --erp-gray-100: #f3f4f6;\r\n  --erp-gray-200: #e5e7eb;\r\n  --erp-gray-300: #d1d5db;\r\n  --erp-gray-400: #9ca3af;\r\n  --erp-gray-500: #6b7280;\r\n  --erp-gray-600: #4b5563;\r\n  --erp-gray-700: #374151;\r\n  --erp-gray-800: #1f2937;\r\n  --erp-gray-900: #111827;\r\n\r\n  /* ── Surfaces ───────────────────────────────────────────── */\r\n  --erp-bg: #f6f7f9;\r\n  --erp-header-bg: #ffffff;\r\n  --erp-surface: #ffffff;\r\n  --erp-surface-muted: #f9fafb;\r\n  --erp-surface-hover: #f3f4f6;\r\n  --erp-surface-alt: #f3f4f6;\r\n  --erp-surface-sunken: #f3f4f6;\r\n\r\n  /* ── Text (all AA on white) ─────────────────────────────── */\r\n  --erp-text-primary: #111827;\r\n  --erp-text-secondary: #4b5563;\r\n  --erp-text-muted: #5f6673; /* a11y: ≥ 4.5:1 on every light surface incl. selected/tinted rows (#6b7280 was 4.2–4.4) */\r\n  --erp-text-placeholder: #9ca3af;\r\n  --erp-text-disabled: #9ca3af;\r\n\r\n  /* ── Borders ────────────────────────────────────────────── */\r\n  --erp-border: #e5e7eb;\r\n  --erp-border-strong: #d1d5db;\r\n  --erp-border-subtle: #f0f1f3;\r\n  --erp-header-border: #e5e7eb;\r\n\r\n  /* ── Accent ─────────────────────────────────────────────── */\r\n  --erp-accent: #2563eb;\r\n  --erp-accent-hover: #1d4ed8;\r\n  --erp-accent-active: #1e40af;\r\n  --erp-accent-muted: rgb(37 99 235 / 0.1);\r\n  --erp-accent-subtle: #eff6ff;\r\n  --erp-accent-text: #1d4ed8;\r\n  --erp-on-accent: #ffffff;\r\n  --erp-trend-up: #059669;\r\n  --erp-trend-down: #dc2626;\r\n\r\n  /* ── Semantic tones: bg / text / border / solid ─────────── */\r\n  --erp-neutral-bg: #f3f4f6;\r\n  --erp-neutral-text: #374151;\r\n  --erp-neutral-border: #e5e7eb;\r\n  --erp-neutral-solid: #6b7280;\r\n\r\n  --erp-info-bg: #eff6ff;\r\n  --erp-info-text: #1d4ed8;\r\n  --erp-info-border: #bfdbfe;\r\n  --erp-info-solid: #2563eb;\r\n\r\n  --erp-success-bg: #ecfdf5;\r\n  --erp-success-text: #047857;\r\n  --erp-success-border: #a7f3d0;\r\n  --erp-success-solid: #10b981;\r\n\r\n  --erp-warning-bg: #fffbeb;\r\n  --erp-warning-text: #b45309;\r\n  --erp-warning-border: #fde68a;\r\n  --erp-warning-solid: #f59e0b;\r\n\r\n  --erp-danger-bg: #fef2f2;\r\n  --erp-danger-text: #b91c1c;\r\n  --erp-danger-border: #fecaca;\r\n  --erp-danger-solid: #dc2626;\r\n  --erp-danger-hover: #b91c1c;\r\n\r\n  /* ── Focus ──────────────────────────────────────────────── */\r\n  --erp-focus-color: #2563eb;\r\n  --erp-focus-ring: 0 0 0 2px #ffffff, 0 0 0 4px var(--erp-focus-color);\r\n  --erp-focus-ring-input: 0 0 0 3px rgb(37 99 235 / 0.2);\r\n  --erp-focus-ring-danger: 0 0 0 3px rgb(220 38 38 / 0.18);\r\n\r\n  /* ── Elevation ──────────────────────────────────────────── */\r\n  --erp-shadow-xs: 0 1px 2px rgb(16 24 40 / 0.04);\r\n  --erp-shadow-sm: 0 1px 2px rgb(16 24 40 / 0.04), 0 1px 3px rgb(16 24 40 / 0.06);\r\n  --erp-shadow-md: 0 4px 8px -2px rgb(16 24 40 / 0.08), 0 2px 4px -2px rgb(16 24 40 / 0.04);\r\n  --erp-shadow-lg: 0 12px 24px -6px rgb(16 24 40 / 0.12), 0 4px 8px -4px rgb(16 24 40 / 0.05);\r\n  --erp-shadow-xl: 0 24px 48px -12px rgb(16 24 40 / 0.22);\r\n  --erp-shadow: var(--erp-shadow-xs);\r\n\r\n  /* ── Z-index scale ──────────────────────────────────────── */\r\n  --erp-z-sticky: 10;\r\n  --erp-z-header: 30;\r\n  --erp-z-sidebar: 40;\r\n  --erp-z-mobile-nav: 9000;\r\n  --erp-z-overlay: 10500;  /* modal + drawer (chat sits at 9980–10000) */\r\n  --erp-z-popover: 11000;  /* menus, selects — above modals */\r\n  --erp-z-toast: 12000;\r\n  --erp-z-tooltip: 12500;\r\n\r\n  /* ── Shell ──────────────────────────────────────────────── */\r\n  --erp-sidebar-w: 248px;\r\n  --erp-sidebar-w-collapsed: 64px;\r\n  --erp-topbar-h: 56px;\r\n\r\n  --erp-sidebar-bg: #fbfbfc;\r\n  --erp-sidebar-hover: #f0f1f4;\r\n  --erp-sidebar-border: #e5e7eb;\r\n  --erp-sidebar-text-primary: #111827;\r\n  --erp-sidebar-text-secondary: #4b5563;\r\n  --erp-sidebar-text-muted: #5f6673;\r\n  --erp-sidebar-active-bg: #e9effd;\r\n  --erp-sidebar-active-text: #1d4ed8;\r\n  --erp-sidebar-glass: #ffffff;\r\n  --erp-sidebar-glass-elevated: #ffffff;\r\n  --erp-sidebar-glass-border: #e5e7eb;\r\n\r\n  /* ── Tables ─────────────────────────────────────────────── */\r\n  --erp-thead-bg: #f9fafb;\r\n  --erp-row-hover: #f7f9fc;\r\n  --erp-row-selected: #eff6ff;\r\n\r\n  /* ── Legacy effect aliases ──────────────────────────────── */\r\n  --erp-glass: #ffffff;\r\n  --erp-glass-elevated: #ffffff;\r\n  --erp-card-blur: none;\r\n  --erp-overlay: rgb(17 24 39 / 0.45);\r\n  --erp-nav-glow: rgb(37 99 235 / 0.35);\r\n  --erp-search-glow: rgb(37 99 235 / 0.2);\r\n  --erp-color-scheme: light;\r\n}\r\n\r\n.erp-theme {\r\n  color: var(--erp-text-primary);\r\n  font-family: var(--erp-font-family);\r\n  font-size: var(--erp-text-base);\r\n  line-height: var(--erp-leading);\r\n  background-color: var(--erp-bg);\r\n  color-scheme: light;\r\n  -webkit-font-smoothing: antialiased;\r\n  -moz-osx-font-smoothing: grayscale;\r\n  font-feature-settings: 'cv11', 'ss01';\r\n}\r\n\r\n.erp-theme-bg {\r\n  min-height: 100vh;\r\n  background-color: var(--erp-bg);\r\n}\r\n\r\n/* Visible focus ring for keyboard users everywhere */\r\n\r\n.erp-theme :focus-visible {\r\n  outline: 2px solid var(--erp-focus-color);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.erp-theme ::-moz-selection {\r\n  background: rgb(37 99 235 / 0.18);\r\n}\r\n\r\n.erp-theme ::selection {\r\n  background: rgb(37 99 235 / 0.18);\r\n}\r\n\r\n/* Utilities */\r\n\r\n.erp-num,\r\n.erp-theme .erp-data-table .erp-num {\r\n  text-align: right;\r\n  font-variant-numeric: tabular-nums;\r\n  white-space: nowrap;\r\n}\r\n\r\n.erp-tabular {\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.erp-sr-only {\r\n  position: absolute;\r\n  width: 1px;\r\n  height: 1px;\r\n  padding: 0;\r\n  margin: -1px;\r\n  overflow: hidden;\r\n  clip: rect(0, 0, 0, 0);\r\n  white-space: nowrap;\r\n  border: 0;\r\n}\r\n\r\n.erp-scroll-x {\r\n  overflow-x: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.erp-hide-scrollbar {\r\n  scrollbar-width: none;\r\n}\r\n\r\n.erp-hide-scrollbar::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   SHELL\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-shell-with-sidebar {\r\n  position: relative;\r\n  min-height: 100vh;\r\n  --erp-current-sidebar-w: var(--erp-sidebar-w);\r\n}\r\n\r\n.erp-shell-with-sidebar[data-collapsed='true'] {\r\n  --erp-current-sidebar-w: var(--erp-sidebar-w-collapsed);\r\n}\r\n\r\n/* display is controlled by utilities (hidden lg:flex) */\r\n\r\n.erp-theme .erp-sidebar {\r\n  flex-direction: column;\r\n  background-color: var(--erp-sidebar-bg);\r\n  border-color: var(--erp-sidebar-border);\r\n  color: var(--erp-sidebar-text-primary);\r\n}\r\n\r\n.erp-sidebar-fixed {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  z-index: var(--erp-z-sidebar);\r\n  height: 100dvh;\r\n  width: var(--erp-current-sidebar-w, var(--erp-sidebar-w));\r\n  flex-direction: column;\r\n  border-right: 1px solid var(--erp-sidebar-border);\r\n  background-color: var(--erp-sidebar-bg);\r\n  transition: width 180ms var(--erp-ease);\r\n}\r\n\r\n.erp-shell-main {\r\n  min-height: 100vh;\r\n  min-width: 0;\r\n  transition: margin-left 180ms var(--erp-ease);\r\n}\r\n\r\n@media (min-width: 1024px) {\r\n  .erp-shell-main {\r\n    margin-left: var(--erp-current-sidebar-w, var(--erp-sidebar-w));\r\n  }\r\n}\r\n\r\n.erp-shell {\r\n  display: flex;\r\n  min-height: calc(100vh - var(--erp-topbar-h));\r\n}\r\n\r\n.erp-theme .erp-header-bar {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: var(--erp-z-header);\r\n  height: var(--erp-topbar-h);\r\n  background-color: rgb(255 255 255 / 0.92);\r\n  backdrop-filter: saturate(180%) blur(8px);\r\n  -webkit-backdrop-filter: saturate(180%) blur(8px);\r\n  border-bottom: 1px solid var(--erp-header-border);\r\n}\r\n\r\n.erp-theme .erp-main-area {\r\n  background-color: var(--erp-bg);\r\n}\r\n\r\n.erp-content {\r\n  min-width: 0;\r\n  padding: var(--erp-space-4);\r\n}\r\n\r\n@media (min-width: 1024px) {\r\n  .erp-content {\r\n    padding: var(--erp-space-6);\r\n  }\r\n}\r\n\r\n/* Forms read better at a bounded width; tables stay full width. */\r\n\r\n.erp-form-width {\r\n  max-width: 960px;\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   SIDEBAR\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-theme .erp-sidebar-glass {\r\n  border: 1px solid var(--erp-sidebar-glass-border);\r\n}\r\n\r\n.erp-theme .erp-sidebar-glass-brand {\r\n  background: var(--erp-sidebar-glass-elevated);\r\n}\r\n\r\n.erp-theme .erp-sidebar-glass-footer {\r\n  background: var(--erp-sidebar-glass);\r\n}\r\n\r\n.erp-theme .erp-nav-item {\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 10px;\r\n  min-height: 34px;\r\n  border-radius: var(--erp-radius-sm);\r\n  padding: 6px 10px;\r\n  font-size: var(--erp-text-base);\r\n  font-weight: 500;\r\n  line-height: 20px;\r\n  color: var(--erp-sidebar-text-secondary);\r\n  text-decoration: none;\r\n  background: transparent;\r\n  border: 0;\r\n  cursor: pointer;\r\n  transition: background var(--erp-duration) var(--erp-ease), color var(--erp-duration) var(--erp-ease);\r\n}\r\n\r\n.erp-theme .erp-nav-item svg {\r\n  flex-shrink: 0;\r\n  color: var(--erp-gray-500);\r\n}\r\n\r\n.erp-theme .erp-sidebar .erp-nav-item:hover {\r\n  background: var(--erp-sidebar-hover);\r\n  color: var(--erp-sidebar-text-primary);\r\n}\r\n\r\n.erp-theme .erp-sidebar .erp-nav-item-active,\r\n.erp-theme .erp-sidebar .erp-nav-item-active:hover {\r\n  background: var(--erp-sidebar-active-bg);\r\n  color: var(--erp-sidebar-active-text);\r\n  font-weight: 600;\r\n}\r\n\r\n.erp-theme .erp-sidebar .erp-nav-item-active svg {\r\n  color: var(--erp-accent);\r\n}\r\n\r\n.erp-nav-badge {\r\n  margin-left: auto;\r\n  display: inline-flex;\r\n  min-width: 20px;\r\n  height: 20px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border-radius: var(--erp-radius-full);\r\n  background: var(--erp-accent);\r\n  padding: 0 6px;\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  line-height: 1;\r\n  color: #fff;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.erp-nav-group-label {\r\n  margin: 16px 0 4px;\r\n  padding: 0 10px;\r\n  font-size: var(--erp-text-xs);\r\n  font-weight: 600;\r\n  letter-spacing: 0.02em;\r\n  color: var(--erp-sidebar-text-muted);\r\n}\r\n\r\n.erp-nav-dropdown-menu {\r\n  border-left: 1px solid var(--erp-sidebar-border);\r\n  margin-left: 18px;\r\n}\r\n\r\n.erp-theme .erp-nav-subitem {\r\n  min-height: 30px;\r\n  font-size: var(--erp-text-sm);\r\n  padding-top: 4px;\r\n  padding-bottom: 4px;\r\n}\r\n\r\n.erp-nav-dropdown-trigger {\r\n  cursor: pointer;\r\n}\r\n\r\n.erp-theme .erp-sidebar-nav {\r\n  scrollbar-width: thin;\r\n  scrollbar-color: var(--erp-gray-300) transparent;\r\n}\r\n\r\n.erp-theme .erp-sidebar-nav::-webkit-scrollbar {\r\n  width: 6px;\r\n}\r\n\r\n.erp-theme .erp-sidebar-nav::-webkit-scrollbar-thumb {\r\n  background: var(--erp-gray-300);\r\n  border-radius: 999px;\r\n}\r\n\r\n/* Collapsed rail */\r\n\r\n.erp-shell-with-sidebar[data-collapsed='true'] .erp-sidebar-fixed .erp-nav-label,\r\n.erp-shell-with-sidebar[data-collapsed='true'] .erp-sidebar-fixed .erp-nav-group-label,\r\n.erp-shell-with-sidebar[data-collapsed='true'] .erp-sidebar-fixed .erp-nav-hide-collapsed {\r\n  display: none;\r\n}\r\n\r\n.erp-shell-with-sidebar[data-collapsed='true'] .erp-sidebar-fixed .erp-nav-item {\r\n  justify-content: center;\r\n  padding-left: 0;\r\n  padding-right: 0;\r\n}\r\n\r\n.erp-shell-with-sidebar[data-collapsed='true'] .erp-sidebar-fixed .erp-nav-badge {\r\n  position: absolute;\r\n  top: 2px;\r\n  right: 6px;\r\n  min-width: 16px;\r\n  height: 16px;\r\n  padding: 0 4px;\r\n  font-size: 10px;\r\n}\r\n\r\n.erp-shell-with-sidebar[data-collapsed='true'] .erp-sidebar-fixed .erp-nav-section + .erp-nav-section {\r\n  margin-top: 8px;\r\n  padding-top: 8px;\r\n  border-top: 1px solid var(--erp-sidebar-border);\r\n}\r\n\r\n/* Legacy mobile drawer classes */\r\n\r\n.erp-drawer-overlay {\r\n  background: var(--erp-overlay);\r\n}\r\n\r\n.erp-drawer-panel {\r\n  background: var(--erp-sidebar-bg);\r\n  border-right: 1px solid var(--erp-sidebar-border);\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   CARDS / SECTIONS\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-theme .erp-card,\r\n.erp-theme .erp-card-sm {\r\n  min-width: 0;\r\n  border-radius: var(--erp-radius-md);\r\n  border: 1px solid var(--erp-border);\r\n  background: var(--erp-surface);\r\n  box-shadow: var(--erp-shadow-xs);\r\n}\r\n\r\n/* Tables placed directly in a card scroll inside the card, not the page */\r\n\r\n.erp-theme .erp-card:has(> table),\r\n.erp-theme .erp-card-sm:has(> table),\r\n.erp-theme .erp-card:has(> .erp-data-table),\r\n.erp-theme .erp-tabshell-body:has(> table) {\r\n  overflow-x: auto;\r\n}\r\n\r\n.erp-section-header {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 14px 16px;\r\n  border-bottom: 1px solid var(--erp-border);\r\n}\r\n\r\n.erp-section-title {\r\n  font-size: var(--erp-text-md);\r\n  font-weight: 600;\r\n  line-height: 24px;\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-section-description {\r\n  margin-top: 2px;\r\n  font-size: var(--erp-text-sm);\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   BUTTONS\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-btn-primary,\r\n.erp-btn-secondary,\r\n.erp-btn-danger,\r\n.erp-btn-danger-solid,\r\n.erp-btn-ghost {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 6px;\r\n  min-height: var(--erp-control-h);\r\n  padding: 0 14px;\r\n  border-radius: var(--erp-radius-sm);\r\n  border: 1px solid transparent;\r\n  font-family: inherit;\r\n  font-size: var(--erp-text-base);\r\n  font-weight: 500;\r\n  line-height: 20px;\r\n  text-decoration: none;\r\n  cursor: pointer;\r\n  -webkit-user-select: none;\r\n     -moz-user-select: none;\r\n          user-select: none;\r\n  transition: background-color var(--erp-duration) var(--erp-ease), border-color var(--erp-duration) var(--erp-ease),\r\n    color var(--erp-duration) var(--erp-ease), box-shadow var(--erp-duration) var(--erp-ease);\r\n}\r\n\r\n.erp-btn-primary:focus-visible,\r\n.erp-btn-secondary:focus-visible,\r\n.erp-btn-danger:focus-visible,\r\n.erp-btn-danger-solid:focus-visible,\r\n.erp-btn-ghost:focus-visible,\r\n.erp-btn-link:focus-visible,\r\n.erp-icon-btn:focus-visible {\r\n  outline: 2px solid var(--erp-focus-color);\r\n  outline-offset: 2px;\r\n}\r\n\r\n.erp-btn-primary {\r\n  background: var(--erp-accent);\r\n  border-color: var(--erp-accent);\r\n  color: var(--erp-on-accent);\r\n  box-shadow: var(--erp-shadow-xs);\r\n}\r\n\r\n.erp-btn-primary:hover:not(:disabled) {\r\n  background: var(--erp-accent-hover);\r\n  border-color: var(--erp-accent-hover);\r\n}\r\n\r\n.erp-btn-primary:active:not(:disabled) {\r\n  background: var(--erp-accent-active);\r\n}\r\n\r\n.erp-btn-secondary {\r\n  background: var(--erp-surface);\r\n  border-color: var(--erp-border-strong);\r\n  color: var(--erp-gray-800);\r\n  box-shadow: var(--erp-shadow-xs);\r\n}\r\n\r\n.erp-btn-secondary:hover:not(:disabled) {\r\n  background: var(--erp-gray-50);\r\n  border-color: var(--erp-gray-400);\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-btn-secondary:active:not(:disabled) {\r\n  background: var(--erp-gray-100);\r\n}\r\n\r\n/* Soft destructive — row-level \"Delete\", \"Reject\", \"Cancel order\" */\r\n\r\n.erp-btn-danger {\r\n  background: var(--erp-surface);\r\n  border-color: var(--erp-danger-border);\r\n  color: var(--erp-danger-text);\r\n}\r\n\r\n.erp-btn-danger:hover:not(:disabled) {\r\n  background: var(--erp-danger-bg);\r\n  border-color: #fca5a5;\r\n}\r\n\r\n/* Solid destructive — confirm buttons in dialogs */\r\n\r\n.erp-btn-danger-solid {\r\n  background: var(--erp-danger-solid);\r\n  border-color: var(--erp-danger-solid);\r\n  color: #fff;\r\n  box-shadow: var(--erp-shadow-xs);\r\n}\r\n\r\n.erp-btn-danger-solid:hover:not(:disabled) {\r\n  background: var(--erp-danger-hover);\r\n  border-color: var(--erp-danger-hover);\r\n}\r\n\r\n.erp-btn-ghost {\r\n  background: transparent;\r\n  color: var(--erp-text-secondary);\r\n}\r\n\r\n.erp-btn-ghost:hover:not(:disabled) {\r\n  background: var(--erp-surface-hover);\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-btn-link {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  padding: 0;\r\n  border: 0;\r\n  background: transparent;\r\n  font-family: inherit;\r\n  font-size: inherit;\r\n  font-weight: 500;\r\n  color: var(--erp-accent);\r\n  cursor: pointer;\r\n  border-radius: 2px;\r\n}\r\n\r\n.erp-btn-link:hover:not(:disabled) {\r\n  color: var(--erp-accent-hover);\r\n  text-decoration: underline;\r\n  text-underline-offset: 2px;\r\n}\r\n\r\n.erp-btn-primary:disabled,\r\n.erp-btn-secondary:disabled,\r\n.erp-btn-danger:disabled,\r\n.erp-btn-danger-solid:disabled,\r\n.erp-btn-ghost:disabled,\r\n.erp-btn-link:disabled,\r\n.erp-icon-btn:disabled {\r\n  opacity: 0.5;\r\n  cursor: not-allowed;\r\n  box-shadow: none;\r\n}\r\n\r\n.erp-btn-primary[aria-busy='true'],\r\n.erp-btn-secondary[aria-busy='true'],\r\n.erp-btn-danger[aria-busy='true'],\r\n.erp-btn-danger-solid[aria-busy='true'],\r\n.erp-btn-ghost[aria-busy='true'] {\r\n  opacity: 0.75;\r\n  cursor: progress;\r\n}\r\n\r\n.erp-btn-sm {\r\n  min-height: var(--erp-control-h-sm);\r\n  padding: 0 10px;\r\n  font-size: var(--erp-text-sm);\r\n  gap: 4px;\r\n}\r\n\r\n.erp-btn-lg {\r\n  min-height: 44px;\r\n  padding: 0 18px;\r\n  font-size: var(--erp-text-md, 15px);\r\n}\r\n\r\n.erp-icon-btn.erp-btn-lg {\r\n  min-width: 44px;\r\n}\r\n\r\n.erp-btn-block {\r\n  width: 100%;\r\n}\r\n\r\n.erp-icon-btn {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  min-width: var(--erp-control-h);\r\n  min-height: var(--erp-control-h);\r\n  padding: 0 8px;\r\n  border-radius: var(--erp-radius-sm);\r\n  border: 1px solid transparent;\r\n  background: transparent;\r\n  color: var(--erp-text-secondary);\r\n  cursor: pointer;\r\n  transition: background-color var(--erp-duration) var(--erp-ease), color var(--erp-duration) var(--erp-ease);\r\n}\r\n\r\n.erp-icon-btn:hover:not(:disabled) {\r\n  background: var(--erp-surface-hover);\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-icon-btn.erp-btn-sm {\r\n  min-width: var(--erp-control-h-sm);\r\n  min-height: var(--erp-control-h-sm);\r\n  padding: 0 6px;\r\n}\r\n\r\n.erp-icon-btn-outlined {\r\n  border-color: var(--erp-border-strong);\r\n  background: var(--erp-surface);\r\n}\r\n\r\n.erp-spinner {\r\n  display: inline-block;\r\n  width: 14px;\r\n  height: 14px;\r\n  flex-shrink: 0;\r\n  border-radius: 9999px;\r\n  border: 2px solid currentColor;\r\n  border-right-color: transparent;\r\n  animation: erp-spin 0.7s linear infinite;\r\n}\r\n\r\n@keyframes erp-spin {\r\n  to {\r\n    transform: rotate(360deg);\r\n  }\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   FORM CONTROLS\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-input,\r\n.erp-select,\r\n.erp-textarea,\r\n.erp-theme .erp-search {\r\n  min-height: var(--erp-control-h);\r\n  padding: 7px 10px;\r\n  border-radius: var(--erp-radius-sm);\r\n  border: 1px solid var(--erp-border-strong);\r\n  background-color: var(--erp-surface);\r\n  color: var(--erp-text-primary);\r\n  font-family: inherit;\r\n  font-size: var(--erp-text-base);\r\n  line-height: 20px;\r\n  box-shadow: var(--erp-shadow-xs);\r\n  transition: border-color var(--erp-duration) var(--erp-ease), box-shadow var(--erp-duration) var(--erp-ease);\r\n}\r\n\r\n.erp-input,\r\n.erp-textarea {\r\n  width: 100%;\r\n}\r\n\r\n.erp-textarea {\r\n  min-height: 80px;\r\n  resize: vertical;\r\n}\r\n\r\n.erp-select {\r\n  color-scheme: light;\r\n}\r\n\r\nselect.erp-select {\r\n  -moz-appearance: none;\r\n       appearance: none;\r\n  -webkit-appearance: none;\r\n  padding-right: 32px;\r\n  background-image: url(\"data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e\");\r\n  background-position: right 8px center;\r\n  background-repeat: no-repeat;\r\n  background-size: 16px 16px;\r\n  cursor: pointer;\r\n}\r\n\r\n.erp-theme .erp-select option {\r\n  background-color: #ffffff;\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-input::-moz-placeholder, .erp-textarea::-moz-placeholder, .erp-theme .erp-search::-moz-placeholder {\r\n  color: var(--erp-text-placeholder);\r\n}\r\n\r\n.erp-input::placeholder,\r\n.erp-textarea::placeholder,\r\n.erp-theme .erp-search::placeholder {\r\n  color: var(--erp-text-placeholder);\r\n}\r\n\r\n.erp-input:hover:not(:disabled):not(:focus),\r\n.erp-select:hover:not(:disabled):not(:focus),\r\n.erp-textarea:hover:not(:disabled):not(:focus) {\r\n  border-color: var(--erp-gray-400);\r\n}\r\n\r\n.erp-input:focus,\r\n.erp-select:focus,\r\n.erp-textarea:focus,\r\n.erp-theme .erp-search:focus,\r\n.erp-select:focus-visible {\r\n  outline: none;\r\n  border-color: var(--erp-accent);\r\n  box-shadow: var(--erp-focus-ring-input);\r\n}\r\n\r\n.erp-input[aria-invalid='true'],\r\n.erp-select[aria-invalid='true'],\r\n.erp-textarea[aria-invalid='true'] {\r\n  border-color: var(--erp-danger-solid) !important;\r\n}\r\n\r\n.erp-input[aria-invalid='true']:focus,\r\n.erp-select[aria-invalid='true']:focus,\r\n.erp-textarea[aria-invalid='true']:focus {\r\n  box-shadow: var(--erp-focus-ring-danger) !important;\r\n}\r\n\r\n.erp-input:disabled,\r\n.erp-select:disabled,\r\n.erp-textarea:disabled,\r\n.erp-input[readonly] {\r\n  background-color: var(--erp-gray-50);\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-input:disabled,\r\n.erp-select:disabled,\r\n.erp-textarea:disabled {\r\n  cursor: not-allowed;\r\n}\r\n\r\n.erp-input-sm {\r\n  min-height: var(--erp-control-h-sm);\r\n  padding-top: 5px;\r\n  padding-bottom: 5px;\r\n  font-size: var(--erp-text-sm);\r\n}\r\n\r\n/* Raw inputs / textareas / selects without erp classes */\r\n\r\n.erp-theme input:not([type='checkbox']):not([type='radio']):not([type='color']):not([type='file']):not([type='range']):not(.erp-search):not(.erp-input),\r\n.erp-theme textarea:not(.erp-textarea),\r\n.erp-theme select:not(.erp-select) {\r\n  border-radius: var(--erp-radius-sm);\r\n  border: 1px solid var(--erp-border-strong);\r\n  background-color: var(--erp-surface);\r\n  color: var(--erp-text-primary);\r\n  padding: 7px 10px;\r\n  font-size: var(--erp-text-base);\r\n  line-height: 20px;\r\n}\r\n\r\n.erp-theme input:not([type='checkbox']):not([type='radio']):not([type='color']):focus,\r\n.erp-theme textarea:focus,\r\n.erp-theme select:not(.erp-select):focus {\r\n  outline: none;\r\n  border-color: var(--erp-accent);\r\n  box-shadow: var(--erp-focus-ring-input);\r\n}\r\n\r\n.erp-theme input:disabled,\r\n.erp-theme textarea:disabled,\r\n.erp-theme select:disabled {\r\n  opacity: 0.7;\r\n  cursor: not-allowed;\r\n}\r\n\r\n.erp-theme input[type='checkbox'],\r\n.erp-theme input[type='radio'] {\r\n  accent-color: var(--erp-accent);\r\n  width: 16px;\r\n  height: 16px;\r\n}\r\n\r\n/* Field wrapper */\r\n\r\n.erp-field {\r\n  display: flex;\r\n  min-width: 0;\r\n  flex-direction: column;\r\n  gap: 6px;\r\n}\r\n\r\n.erp-field-label,\r\n.erp-label {\r\n  font-size: var(--erp-text-xs);\r\n  font-weight: 500;\r\n  line-height: 16px;\r\n  color: var(--erp-text-secondary);\r\n}\r\n\r\n.erp-field-required {\r\n  margin-left: 2px;\r\n  color: var(--erp-danger-solid);\r\n}\r\n\r\n.erp-field-hint {\r\n  font-size: var(--erp-text-xs);\r\n  line-height: 16px;\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-field-error {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  font-size: var(--erp-text-xs);\r\n  line-height: 16px;\r\n  color: var(--erp-danger-text);\r\n}\r\n\r\n/* Search input */\r\n\r\n.erp-search-input {\r\n  position: relative;\r\n  display: flex;\r\n  min-width: 0;\r\n  align-items: center;\r\n}\r\n\r\n.erp-search-input > .erp-search-icon {\r\n  pointer-events: none;\r\n  position: absolute;\r\n  left: 10px;\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-search-input > input.erp-input {\r\n  padding-left: 32px;\r\n  padding-right: 32px;\r\n}\r\n\r\n.erp-search-input > .erp-search-clear {\r\n  position: absolute;\r\n  right: 4px;\r\n  display: inline-flex;\r\n  height: 28px;\r\n  width: 28px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  border-radius: var(--erp-radius-sm);\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-search-input > .erp-search-clear:hover {\r\n  background: var(--erp-surface-hover);\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   DATA TABLE\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-theme .erp-data-table {\r\n  width: 100%;\r\n  border-collapse: separate;\r\n  border-spacing: 0;\r\n  font-size: var(--erp-text-sm);\r\n  line-height: 18px;\r\n}\r\n\r\n.erp-theme .erp-data-table thead {\r\n  background: var(--erp-thead-bg);\r\n}\r\n\r\n.erp-theme .erp-data-table th {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 1;\r\n  height: 36px;\r\n  padding: 8px 12px;\r\n  background: var(--erp-thead-bg);\r\n  border-bottom: 1px solid var(--erp-border);\r\n  color: var(--erp-text-muted);\r\n  font-size: var(--erp-text-xs);\r\n  font-weight: 600;\r\n  line-height: 16px;\r\n  text-align: left;\r\n  text-transform: none;\r\n  letter-spacing: 0;\r\n  white-space: nowrap;\r\n}\r\n\r\n.erp-theme .erp-data-table td {\r\n  height: var(--erp-row-h);\r\n  padding: 8px 12px;\r\n  border-bottom: 1px solid var(--erp-border-subtle);\r\n  color: var(--erp-gray-700);\r\n  text-align: left;\r\n  vertical-align: middle;\r\n}\r\n\r\n.erp-theme .erp-data-table tbody tr:last-child td {\r\n  border-bottom: 0;\r\n}\r\n\r\n.erp-theme .erp-data-table th:first-child,\r\n.erp-theme .erp-data-table td:first-child {\r\n  padding-left: 16px;\r\n}\r\n\r\n.erp-theme .erp-data-table th:last-child,\r\n.erp-theme .erp-data-table td:last-child {\r\n  padding-right: 16px;\r\n}\r\n\r\n.erp-theme .erp-data-table tbody tr {\r\n  transition: background-color var(--erp-duration) var(--erp-ease);\r\n}\r\n\r\n.erp-theme .erp-data-table tbody tr:hover {\r\n  background: var(--erp-row-hover);\r\n}\r\n\r\n.erp-theme .erp-data-table tbody tr.erp-row-clickable {\r\n  cursor: pointer;\r\n}\r\n\r\n.erp-theme .erp-data-table tbody tr.erp-row-clickable:hover td:first-child {\r\n  box-shadow: inset 2px 0 0 var(--erp-accent);\r\n}\r\n\r\n.erp-theme .erp-data-table tbody tr.erp-row-selected,\r\n.erp-theme .erp-data-table tbody tr[aria-selected='true'] {\r\n  background: var(--erp-row-selected);\r\n}\r\n\r\n/* Codes / document numbers never wrap */\r\n\r\n.erp-theme .erp-data-table td .font-mono,\r\n.erp-theme .erp-data-table td code,\r\n.erp-theme .erp-data-table td.font-mono {\r\n  white-space: nowrap;\r\n}\r\n\r\n.erp-theme .erp-data-table .erp-cell-primary {\r\n  font-weight: 500;\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-theme .erp-data-table .erp-cell-actions {\r\n  width: 1%;\r\n  white-space: nowrap;\r\n  text-align: right;\r\n}\r\n\r\n.erp-table-wrap {\r\n  overflow-x: auto;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.erp-pager {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n  gap: 8px;\r\n  padding: 10px 16px;\r\n  border-top: 1px solid var(--erp-border);\r\n  font-size: var(--erp-text-sm);\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n/* Skeleton */\r\n\r\n.erp-skeleton {\r\n  display: block;\r\n  border-radius: 4px;\r\n  background: linear-gradient(90deg, var(--erp-gray-100) 0%, #eceef1 40%, var(--erp-gray-100) 80%);\r\n  background-size: 200% 100%;\r\n  animation: erp-shimmer 1.3s ease-in-out infinite;\r\n}\r\n\r\n@keyframes erp-shimmer {\r\n  0% {\r\n    background-position: 100% 0;\r\n  }\r\n  100% {\r\n    background-position: -100% 0;\r\n  }\r\n}\r\n\r\n@media (prefers-reduced-motion: reduce) {\r\n  .erp-skeleton,\r\n  .erp-spinner {\r\n    animation-duration: 2.5s;\r\n  }\r\n}\r\n\r\n/* Empty state */\r\n\r\n.erp-empty {\r\n  display: flex;\r\n  flex-direction: column;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: 4px;\r\n  padding: 40px 16px;\r\n  text-align: center;\r\n}\r\n\r\n.erp-empty-icon {\r\n  display: inline-flex;\r\n  height: 40px;\r\n  width: 40px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  margin-bottom: 8px;\r\n  border-radius: var(--erp-radius-md);\r\n  background: var(--erp-gray-100);\r\n  color: var(--erp-gray-500);\r\n}\r\n\r\n.erp-empty-title {\r\n  font-size: var(--erp-text-base);\r\n  font-weight: 600;\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-empty-description {\r\n  max-width: 420px;\r\n  font-size: var(--erp-text-sm);\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   BADGES\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-badge,\r\n.erp-theme .erp-status-badge {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  max-width: 100%;\r\n  height: 22px;\r\n  padding: 0 8px;\r\n  border-radius: var(--erp-radius-full);\r\n  border: 1px solid transparent;\r\n  font-size: var(--erp-text-xs);\r\n  font-weight: 500;\r\n  line-height: 1;\r\n  white-space: nowrap;\r\n  vertical-align: middle;\r\n}\r\n\r\n.erp-badge-dot {\r\n  display: inline-block;\r\n  height: 6px;\r\n  width: 6px;\r\n  flex-shrink: 0;\r\n  border-radius: 9999px;\r\n  background: currentColor;\r\n}\r\n\r\n.erp-badge-neutral {\r\n  background: var(--erp-neutral-bg);\r\n  color: var(--erp-neutral-text);\r\n  border-color: var(--erp-neutral-border);\r\n}\r\n\r\n.erp-badge-neutral .erp-badge-dot {\r\n  background: var(--erp-neutral-solid);\r\n}\r\n\r\n.erp-badge-info,\r\n.erp-theme .erp-status-shipped {\r\n  background: var(--erp-info-bg);\r\n  color: var(--erp-info-text);\r\n  border-color: var(--erp-info-border);\r\n}\r\n\r\n.erp-badge-info .erp-badge-dot {\r\n  background: var(--erp-info-solid);\r\n}\r\n\r\n.erp-badge-success,\r\n.erp-theme .erp-status-delivered {\r\n  background: var(--erp-success-bg);\r\n  color: var(--erp-success-text);\r\n  border-color: var(--erp-success-border);\r\n}\r\n\r\n.erp-badge-success .erp-badge-dot {\r\n  background: var(--erp-success-solid);\r\n}\r\n\r\n.erp-badge-warning,\r\n.erp-theme .erp-status-pending {\r\n  background: var(--erp-warning-bg);\r\n  color: var(--erp-warning-text);\r\n  border-color: var(--erp-warning-border);\r\n}\r\n\r\n.erp-badge-warning .erp-badge-dot {\r\n  background: var(--erp-warning-solid);\r\n}\r\n\r\n.erp-badge-danger,\r\n.erp-theme .erp-status-cancelled {\r\n  background: var(--erp-danger-bg);\r\n  color: var(--erp-danger-text);\r\n  border-color: var(--erp-danger-border);\r\n}\r\n\r\n.erp-badge-danger .erp-badge-dot {\r\n  background: var(--erp-danger-solid);\r\n}\r\n\r\n.erp-count-pill {\r\n  display: inline-flex;\r\n  min-width: 20px;\r\n  height: 18px;\r\n  align-items: center;\r\n  justify-content: center;\r\n  padding: 0 6px;\r\n  border-radius: var(--erp-radius-full);\r\n  background: var(--erp-gray-100);\r\n  color: var(--erp-text-secondary);\r\n  font-size: 11px;\r\n  font-weight: 600;\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   TABS — underline\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-tabs {\r\n  display: flex;\r\n  flex-wrap: nowrap;\r\n  gap: 4px;\r\n  overflow-x: auto;\r\n  overflow-y: hidden;\r\n  border-bottom: 1px solid var(--erp-border);\r\n  margin-bottom: 16px;\r\n  scrollbar-width: none;\r\n  -webkit-overflow-scrolling: touch;\r\n}\r\n\r\n.erp-tabs::-webkit-scrollbar {\r\n  display: none;\r\n}\r\n\r\n.erp-tab {\r\n  display: inline-flex;\r\n  flex-shrink: 0;\r\n  align-items: center;\r\n  gap: 6px;\r\n  padding: 10px 10px;\r\n  margin-bottom: -1px;\r\n  border: none;\r\n  border-bottom: 2px solid transparent;\r\n  background: transparent;\r\n  color: var(--erp-text-muted);\r\n  font-family: inherit;\r\n  font-size: var(--erp-text-base);\r\n  font-weight: 500;\r\n  line-height: 20px;\r\n  white-space: nowrap;\r\n  cursor: pointer;\r\n  transition: color var(--erp-duration) var(--erp-ease), border-color var(--erp-duration) var(--erp-ease);\r\n}\r\n\r\n.erp-tab:hover {\r\n  color: var(--erp-text-primary);\r\n  border-bottom-color: var(--erp-gray-300);\r\n}\r\n\r\n.erp-tab:focus-visible {\r\n  outline: 2px solid var(--erp-focus-color);\r\n  outline-offset: -2px;\r\n  border-radius: 4px;\r\n}\r\n\r\n.erp-tab-active,\r\n.erp-tab-active:hover {\r\n  color: var(--erp-accent-text);\r\n  border-bottom-color: var(--erp-accent);\r\n}\r\n\r\n.erp-tab-active .erp-count-pill {\r\n  background: var(--erp-accent-subtle);\r\n  color: var(--erp-accent-text);\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   PAGE HEADER\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-page-header {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 12px 16px;\r\n  margin-bottom: 20px;\r\n}\r\n\r\n.erp-page-header-main {\r\n  min-width: 0;\r\n  flex: 1 1 320px;\r\n}\r\n\r\n.erp-page-header-actions {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 8px;\r\n}\r\n\r\n.erp-page-title {\r\n  font-size: var(--erp-text-lg);\r\n  font-weight: 600;\r\n  line-height: 28px;\r\n  letter-spacing: -0.01em;\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-page-subtitle {\r\n  margin-top: 2px;\r\n  max-width: 72ch;\r\n  font-size: var(--erp-text-base);\r\n  line-height: 20px;\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-breadcrumbs {\r\n  display: flex;\r\n  min-width: 0;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  gap: 4px;\r\n  font-size: var(--erp-text-sm);\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-breadcrumbs a {\r\n  color: var(--erp-text-muted);\r\n  text-decoration: none;\r\n  border-radius: 2px;\r\n}\r\n\r\n.erp-breadcrumbs a:hover {\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-breadcrumbs [aria-current='page'] {\r\n  color: var(--erp-text-primary);\r\n  font-weight: 500;\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   ALERTS / BANNERS\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-alert-error,\r\n.erp-alert-success,\r\n.erp-alert-warning,\r\n.erp-alert-info {\r\n  border-radius: var(--erp-radius-md);\r\n  border: 1px solid;\r\n  padding: 10px 12px;\r\n  font-size: var(--erp-text-sm);\r\n  line-height: 20px;\r\n}\r\n\r\n.erp-alert-error {\r\n  background: var(--erp-danger-bg);\r\n  border-color: var(--erp-danger-border);\r\n  color: var(--erp-danger-text);\r\n}\r\n\r\n.erp-alert-success {\r\n  background: var(--erp-success-bg);\r\n  border-color: var(--erp-success-border);\r\n  color: var(--erp-success-text);\r\n}\r\n\r\n.erp-alert-warning {\r\n  background: var(--erp-warning-bg);\r\n  border-color: var(--erp-warning-border);\r\n  color: var(--erp-warning-text);\r\n}\r\n\r\n.erp-alert-info {\r\n  background: var(--erp-info-bg);\r\n  border-color: var(--erp-info-border);\r\n  color: var(--erp-info-text);\r\n}\r\n\r\n.erp-link {\r\n  color: var(--erp-accent);\r\n  text-decoration: none;\r\n}\r\n\r\n.erp-link:hover {\r\n  text-decoration: underline;\r\n}\r\n\r\n.text-erp-xs {\r\n  font-size: var(--erp-text-xs);\r\n}\r\n\r\n.text-erp-sm {\r\n  font-size: var(--erp-text-sm);\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   KPI\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-kpi-label {\r\n  font-size: var(--erp-text-xs);\r\n  font-weight: 500;\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-kpi-value {\r\n  color: var(--erp-text-primary);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.erp-kpi-grid {\r\n  display: grid;\r\n  gap: 12px;\r\n  grid-template-columns: repeat(2, minmax(0, 1fr));\r\n}\r\n\r\n.erp-kpi-grid > .erp-stat-tile {\r\n  border: 1px solid var(--erp-border);\r\n  border-radius: var(--erp-radius-md);\r\n  box-shadow: var(--erp-shadow-xs);\r\n}\r\n\r\n.erp-stat-tile.erp-stat-tile-selected {\r\n  box-shadow: inset 0 0 0 2px var(--erp-accent);\r\n  background: var(--erp-accent-subtle);\r\n}\r\n\r\n.erp-kpi-grid > .erp-stat-tile.erp-stat-tile-selected {\r\n  border-color: var(--erp-accent);\r\n  box-shadow: inset 0 0 0 1px var(--erp-accent);\r\n}\r\n\r\n/* a11y: muted grey on the blue-tinted selected background is < 4.5:1 — use the secondary text tone. */\r\n\r\n.erp-stat-tile.erp-stat-tile-selected .erp-kpi-label,\r\n.erp-stat-tile.erp-stat-tile-selected .text-erp-text-muted {\r\n  color: var(--erp-text-secondary);\r\n}\r\n\r\n@media (min-width: 768px) {\r\n  .erp-kpi-grid[data-cols='3'],\r\n  .erp-kpi-grid[data-cols='6'] {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n  .erp-kpi-grid[data-cols='4'] {\r\n    grid-template-columns: repeat(4, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (min-width: 1280px) {\r\n  .erp-kpi-grid[data-cols='6'] {\r\n    grid-template-columns: repeat(6, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   OVERLAYS — modal, drawer, menu, tooltip, toast\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-overlay-backdrop {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: var(--erp-z-overlay);\r\n  background: var(--erp-overlay);\r\n  animation: erp-fade-in 140ms var(--erp-ease);\r\n}\r\n\r\n.erp-overlay-layer {\r\n  position: fixed;\r\n  inset: 0;\r\n  z-index: var(--erp-z-overlay);\r\n}\r\n\r\n.erp-modal-overlay {\r\n  background: var(--erp-overlay) !important;\r\n}\r\n\r\n.erp-modal {\r\n  position: relative;\r\n  display: flex;\r\n  max-height: calc(100dvh - 32px);\r\n  width: 100%;\r\n  flex-direction: column;\r\n  border-radius: var(--erp-radius-lg);\r\n  border: 1px solid var(--erp-border);\r\n  background: var(--erp-surface);\r\n  box-shadow: var(--erp-shadow-xl);\r\n  animation: erp-pop-in 160ms var(--erp-ease);\r\n}\r\n\r\n.erp-drawer {\r\n  position: fixed;\r\n  top: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  z-index: var(--erp-z-overlay);\r\n  display: flex;\r\n  width: 100%;\r\n  flex-direction: column;\r\n  border-left: 1px solid var(--erp-border);\r\n  background: var(--erp-surface);\r\n  box-shadow: var(--erp-shadow-xl);\r\n  animation: erp-slide-in 200ms var(--erp-ease);\r\n}\r\n\r\n.erp-overlay-header {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  justify-content: space-between;\r\n  gap: 12px;\r\n  padding: 16px 20px;\r\n  border-bottom: 1px solid var(--erp-border);\r\n}\r\n\r\n.erp-overlay-title {\r\n  font-size: var(--erp-text-md);\r\n  font-weight: 600;\r\n  line-height: 24px;\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-overlay-description {\r\n  margin-top: 2px;\r\n  font-size: var(--erp-text-sm);\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-overlay-body {\r\n  min-height: 0;\r\n  flex: 1 1 auto;\r\n  overflow-y: auto;\r\n  padding: 20px;\r\n}\r\n\r\n.erp-overlay-footer {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  align-items: center;\r\n  justify-content: flex-end;\r\n  gap: 8px;\r\n  padding: 12px 20px;\r\n  border-top: 1px solid var(--erp-border);\r\n  background: var(--erp-surface-muted);\r\n  border-bottom-left-radius: inherit;\r\n  border-bottom-right-radius: inherit;\r\n}\r\n\r\n.erp-menu {\r\n  position: fixed;\r\n  z-index: var(--erp-z-popover);\r\n  min-width: 180px;\r\n  max-width: 320px;\r\n  padding: 4px;\r\n  border-radius: var(--erp-radius-md);\r\n  border: 1px solid var(--erp-border);\r\n  background: var(--erp-surface);\r\n  box-shadow: var(--erp-shadow-lg);\r\n  animation: erp-fade-in 100ms var(--erp-ease);\r\n}\r\n\r\n.erp-menu-item {\r\n  display: flex;\r\n  width: 100%;\r\n  align-items: center;\r\n  gap: 8px;\r\n  min-height: 32px;\r\n  padding: 6px 8px;\r\n  border: 0;\r\n  border-radius: 4px;\r\n  background: transparent;\r\n  color: var(--erp-text-primary);\r\n  font-family: inherit;\r\n  font-size: var(--erp-text-sm);\r\n  text-align: left;\r\n  cursor: pointer;\r\n}\r\n\r\n.erp-menu-item svg {\r\n  flex-shrink: 0;\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-menu-item:focus,\r\n.erp-menu-item[data-highlighted='true'] {\r\n  outline: none;\r\n  background: var(--erp-surface-hover);\r\n}\r\n\r\n.erp-menu-item-danger {\r\n  color: var(--erp-danger-text);\r\n}\r\n\r\n.erp-menu-item-danger svg {\r\n  color: var(--erp-danger-text);\r\n}\r\n\r\n.erp-menu-item-danger:focus,\r\n.erp-menu-item-danger[data-highlighted='true'] {\r\n  background: var(--erp-danger-bg);\r\n}\r\n\r\n.erp-menu-item[aria-disabled='true'] {\r\n  color: var(--erp-text-disabled);\r\n  cursor: not-allowed;\r\n}\r\n\r\n.erp-menu-item[aria-disabled='true'] svg {\r\n  color: var(--erp-text-disabled);\r\n}\r\n\r\n.erp-menu-separator {\r\n  height: 1px;\r\n  margin: 4px -4px;\r\n  background: var(--erp-border);\r\n}\r\n\r\n.erp-menu-label {\r\n  padding: 6px 8px 4px;\r\n  font-size: var(--erp-text-xs);\r\n  font-weight: 600;\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-tooltip {\r\n  position: fixed;\r\n  z-index: var(--erp-z-tooltip);\r\n  max-width: 280px;\r\n  padding: 6px 8px;\r\n  border-radius: var(--erp-radius-sm);\r\n  background: var(--erp-gray-900);\r\n  color: #fff;\r\n  font-size: var(--erp-text-xs);\r\n  font-weight: 500;\r\n  line-height: 16px;\r\n  pointer-events: none;\r\n  box-shadow: var(--erp-shadow-md);\r\n  animation: erp-fade-in 100ms var(--erp-ease);\r\n}\r\n\r\n/* Bottom-right, above the chat button: at the top they covered the page-header actions\r\n   (New / Export) — and hovering a toast pauses it, so the button stayed hidden. */\r\n\r\n.erp-toast-region {\r\n  position: fixed;\r\n  /* Beside the chat button (bottom-right, ~52px wide) and above drawer / sticky footers (~64px). */\r\n  bottom: 88px;\r\n  right: 92px;\r\n  z-index: var(--erp-z-toast);\r\n  display: flex;\r\n  width: min(380px, calc(100vw - 108px));\r\n  flex-direction: column;\r\n  gap: 8px;\r\n  pointer-events: none;\r\n}\r\n\r\n@media (max-width: 640px) {\r\n  /* Phones: full width, stacked above the chat button and the bottom nav. */\r\n  .erp-toast-region {\r\n    bottom: 168px;\r\n    right: 16px;\r\n    width: calc(100vw - 32px);\r\n  }\r\n}\r\n\r\n.erp-toast {\r\n  display: flex;\r\n  align-items: flex-start;\r\n  gap: 10px;\r\n  padding: 12px 12px 12px 14px;\r\n  border-radius: var(--erp-radius-md);\r\n  border: 1px solid var(--erp-border);\r\n  background: var(--erp-surface);\r\n  box-shadow: var(--erp-shadow-lg);\r\n  pointer-events: auto;\r\n  animation: erp-toast-in 180ms var(--erp-ease);\r\n}\r\n\r\n.erp-toast-title {\r\n  font-size: var(--erp-text-sm);\r\n  font-weight: 600;\r\n  line-height: 20px;\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.erp-toast-description {\r\n  margin-top: 2px;\r\n  font-size: var(--erp-text-sm);\r\n  line-height: 18px;\r\n  color: var(--erp-text-secondary);\r\n}\r\n\r\n@keyframes erp-fade-in {\r\n  from {\r\n    opacity: 0;\r\n  }\r\n  to {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@keyframes erp-pop-in {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(6px) scale(0.98);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: none;\r\n  }\r\n}\r\n\r\n@keyframes erp-slide-in {\r\n  from {\r\n    transform: translateX(24px);\r\n    opacity: 0.6;\r\n  }\r\n  to {\r\n    transform: none;\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n@keyframes erp-toast-in {\r\n  from {\r\n    opacity: 0;\r\n    transform: translateY(-6px);\r\n  }\r\n  to {\r\n    opacity: 1;\r\n    transform: none;\r\n  }\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   STEP FLOW / DESCRIPTION LIST\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.erp-dl {\r\n  display: grid;\r\n  gap: 12px 24px;\r\n  grid-template-columns: repeat(1, minmax(0, 1fr));\r\n}\r\n\r\n@media (min-width: 640px) {\r\n  .erp-dl[data-cols='2'],\r\n  .erp-dl[data-cols='3'] {\r\n    grid-template-columns: repeat(2, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n@media (min-width: 1024px) {\r\n  .erp-dl[data-cols='3'] {\r\n    grid-template-columns: repeat(3, minmax(0, 1fr));\r\n  }\r\n}\r\n\r\n.erp-dl dt {\r\n  font-size: var(--erp-text-xs);\r\n  font-weight: 500;\r\n  color: var(--erp-text-muted);\r\n}\r\n\r\n.erp-dl dd {\r\n  margin-top: 2px;\r\n  font-size: var(--erp-text-base);\r\n  color: var(--erp-text-primary);\r\n  overflow-wrap: anywhere;\r\n}\r\n\r\n/* ═══════════════════════════════════════════════════════════\r\n   CHAT — opaque slide-out panel (portaled to body)\r\n   ═══════════════════════════════════════════════════════════ */\r\n\r\n.chat-portal-root .chat-panel-drawer {\r\n  background: var(--erp-surface, #ffffff);\r\n  color: var(--erp-text-primary);\r\n}\r\n\r\n.chat-portal-root .chat-panel-drawer header {\r\n  background: var(--erp-surface, #ffffff);\r\n}\r\n\r\n.chat-portal-root .chat-panel-drawer .erp-card,\r\n.chat-portal-root .chat-panel-drawer .erp-card-sm {\r\n  background: var(--erp-surface-muted, #f8fafc);\r\n  backdrop-filter: none;\r\n  -webkit-backdrop-filter: none;\r\n}\r\n\r\n.chat-portal-root .chat-messenger-panel .erp-card,\r\n.chat-portal-root .chat-messenger-panel .erp-card-sm {\r\n  background: transparent;\r\n  border: none;\r\n  box-shadow: none;\r\n}\r\n\r\n.chat-portal-root .chat-panel-thread {\r\n  background: var(--erp-surface, #ffffff);\r\n}\r\n\r\n.chat-portal-root .chat-panel-list {\r\n  background: var(--erp-surface-muted, #f8fafc);\r\n  border-right: 1px solid var(--erp-border);\r\n}\r\n\r\n.chat-portal-root .chat-bubble-incoming {\r\n  background: var(--erp-surface-muted, #f1f5f9);\r\n  border: 1px solid var(--erp-border);\r\n}\r\n\r\n.chat-portal-root .chat-group-modal {\r\n  background: var(--erp-surface, #ffffff);\r\n}\r\n\r\n.chat-portal-root .chat-toast {\r\n  background: var(--erp-surface, #ffffff);\r\n}\r\n\r\n*, ::before, ::after {\r\n  --tw-border-spacing-x: 0;\r\n  --tw-border-spacing-y: 0;\r\n  --tw-translate-x: 0;\r\n  --tw-translate-y: 0;\r\n  --tw-rotate: 0;\r\n  --tw-skew-x: 0;\r\n  --tw-skew-y: 0;\r\n  --tw-scale-x: 1;\r\n  --tw-scale-y: 1;\r\n  --tw-pan-x:  ;\r\n  --tw-pan-y:  ;\r\n  --tw-pinch-zoom:  ;\r\n  --tw-scroll-snap-strictness: